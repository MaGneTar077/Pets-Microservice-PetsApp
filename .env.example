# Copia este archivo como .env y rellena los valores. .env está en .gitignore.
# Las marcadas como SECRETO van en Secret Manager, nunca en texto plano en Cloud Run.

# --- Base de datos (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/myanimalog
DB_USERNAME=postgres
DB_PASSWORD=                      # SECRETO

# --- Seguridad: JWT RS256 del User service (CONTRATOS_COMPARTIDOS.md §1.1) ---
# JWKS del User service. Sin esta variable el servicio no arranca.
JWT_JWKS_URI=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=myanimalog-user-service
JWT_AUDIENCE=myanimalog-api

# --- Seguridad: llamadas servicio a servicio a /internal/** (§2) ---
# Misma clave en todos los servicios. Sin esta variable, o en blanco, el servicio NO arranca.
INTERNAL_API_KEY=                 # SECRETO

# --- Supabase Storage (fotos y documentos) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=                     # SECRETO

# --- Google Cloud Pub/Sub ---
GCP_PROJECT_ID=my-animalog

# --- Otros servicios ---
USER_SERVICE_URL=http://localhost:8080

# --- Servidor ---
PORT=8081
